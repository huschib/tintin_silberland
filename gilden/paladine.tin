 */

#CLASS {paladine} {kill}
#CLASS {paladine} {open}

#ECHO {<029> -> <188>%s<288> geladen<099>} {gilden/paladine.tin}

#VAR gilden_report_cmd  {pstatus}
#VAR color_spell_ende   {<339>}
#VAR color_inactive     {<g02>}
#VAR color_active       {<099>}
#VAR color_learn        {lime}
#VAR color_not_learn    {red}

#HIGHLIGHT {^Paladin! Du lernst aus Deinem Fehler dazu!} {$color_learn}
#HIGHLIGHT {^Auch wenn Du versagt hast, lernst Du aus Deinem Fehler, Paladin!} {$color_learn}
#HIGHLIGHT {^Du dankst Dusty fuer den Fehlschlag und lernst fuer die Zukunft dazu, Paladin!} {$color_learn}
#HIGHLIGHT {^Dein Fehler verhilft Dir '%1' weiter zu lernen, Paladin!} {$color_learn}
#HIGHLIGHT {^Trotz Deines Fehlschlages lernst Du aus Deinem Fehler dazu, Paladin!} {$color_learn}

#HIGHLIGHT {^Du lernst nichts mehr, Paladin! Du musst erst besser werden!} {$color_not_learn}

#HIGHLIGHT {^Mit %1 wirst Du Deinen Schwertkampf weiter erfolgreich ueben koennen!} {bold};
#HIGHLIGHT {^Bei Dusty! %1 ein wuerdiger Gegner! Bei %1 wirst Du sicher Deinen$} {bold};
#HIGHLIGHT {^Schwertkampf lernen.$} {bold};

#HIGHLIGHT {^Du kannst wieder hoeren!} {underscore}
#HIGHLIGHT {^Du kannst wieder sehen!} {underscore}

#HIGHLIGHT {^Dein Heiligenschein verblasst.} {$color_spell_ende}
#HIGHLIGHT {^Deine Schildparade laesst{( langsam)*} nach{(, Paladin)*}!} {$color_spell_ende}
#HIGHLIGHT {^Der Ruestungssegen erlischt!} {$color_spell_ende}
#HIGHLIGHT {^Der Waffensegen von %+ erlischt!} {$color_spell_ende}


#LIST status_items CREATE {status_session;status_hp;status_mp;status_align;status_paladine_aktiv;status_nospell;status_zustand;status_halsband}

#ALIAS {status_var_update} {
    #VAR %1 {@{%1}{}};
    #LIST status_items FIND %1 tmp_status_index;
    #IF { $tmp_status_index > 0 } {
        #VAR statusline_list[$tmp_status_index] {${%1}};
    };
    draw_status    
}

#NOP { /**
 *  @fn     status_paladine
 *  @brief  setzt Block mit aktiven Spells fuer die Statuszeile
 *
 *  @return     formatierter String
 */};

#FUNCTION {status_paladine_aktiv} {
    #VAR gesamt_tmp {};
    #LIST gesamt_tmp COPY paladine_aktiv;
    #LIST gesamt_tmp INDEXATE symbol;
    #LIST gesamt_tmp COLLAPSE {};
    #FORMAT {gesamt_tmp} {%s<099>|} {$gesamt_tmp};
    #RETURN $gesamt_tmp
}

#EVENT {VARIABLE UPDATED paladine_aktiv} {
    status_var_update status_paladine_aktiv
}

#VAR paladine_aktiv {
    {1}     {{name} {heiligenschein}    {symbol}    {${color_inactive}H}}
    {2}     {{name} {schildparade}      {symbol}    {${color_inactive}P}}
    {3}     {{name} {ruestungssegen}    {symbol}    {${color_inactive}R}}
    {4}     {{name} {waffensegen}       {symbol}    {${color_inactive}W}}
    {5}     {{name} {goetterschutz}     {symbol}    {${color_inactive}G}}
    {6}     {{name} {gottsegen}         {symbol}    {${color_inactive}S}}
    {7}     {{name} {talisman}          {symbol}    {${color_inactive}T}}
    {8}     {{name} {spiegelschild}     {symbol}    {${color_inactive}M}}
    {9}     {{name} {eifer}             {symbol}    {${color_inactive}E}}
}

#ALIAS {change_status_symbol_aktiv} {
    change_status_symbol paladine_aktiv {%1} {%2} {%3}
} {5};

#ALIAS {set_status_symbol_aktiv} {
    set_status_symbol paladine_aktiv {%1} {%2}
} {5};

#ALIAS {spell_ende} {
    timer_end %2;
    #ECHO {%c%s%c (%t)} {$color_spell_ende} {%1} {<099>} {{%M:%S}{$timer[%2][dauer]}};
} {5};

#NOP { /**
 *  @fn     status_zustand
 *  @brief  setzt Block mit aktuellem Zustand fuer die Statuszeile
 *
 *  @return     formatierter String
 */};

#FUNCTION {status_zustand} {
    #LIST result COPY paladine_zustand;
    #LIST result COLLAPSE {};
    #FORMAT {result} {%s<099>|} {$result}
}

#EVENT {VARIABLE UPDATED paladine_zustand} {
    status_var_update status_zustand
}

#VAR paladine_zustand {
}

#NOP { /**
 *	@brief	Preport Level 1
 */};

#ACTION {^%.-%.-%.-%.-%.-%.-%.-%.-%.-[%+]--(%+)%+ LPs: %+1..d(%+), MPs: %+1..d(%+)} {
    #FORMAT {align} {%p} {%11};
    #IF {"$status[align]" != "%11"}
    {
        #FORMAT {status[align]} {%p} {%11}
    };
    #VAR paladine_zustand %10;

    #IF {!@_an_aus{config[report]}} {
        #LINE GAG
    }
}

#NOP { /**
 *	@brief	Paladinfertigkeiten
 */};

#ACTION {^Ayla sagt: %+1..w%+1..s - %+.} {
    #ECHO {%s %s} {@dotfill{<ffd>%1<099>;40}} {@pala_fert{%3}<099>};
    #LINE GAG
}

#ACTION {^Ayla sagt: Das Kaempfen mit dem Schwert beherrschst Du %+.} {
    #ECHO {%s %s} {@dotfill{<ffd>Schwertkampf<099>;40}} {@pala_fert{%1}<099>};
    #LINE GAG
}

#ACTION {^Ayla sagt: In Summe gesehen bist Du %+.} {
    #ECHO {%s %s} {@dotfill{<ffd>In Summe<099>;40}} {@pala_fert{%1}<099>};
    #LINE GAG
}

#FUNCTION pala_fert {
    #LIST pfort FIND {%0} tmp;
    #IF {$tmp < 6} {
        #VAR tmp_color {<bba>}
    };
    #ELSEIF {$tmp < 9} {
        #VAR tmp_color {<bca>}
    };
    #ELSEIF {$tmp < 12} {
        #VAR tmp_color {<dea>}
    };
    #ELSEIF {$tmp < 15} {
        #VAR tmp_color {<fea>}
    };
    #ELSEIF {$tmp < 17} {
        #VAR tmp_color {<F8fb>}
    };
    #ELSEIF {$tmp < 19} {
        #VAR tmp_color {<F6f6>}
    };
    #ELSEIF {$tmp < 21} {
        #VAR tmp_color {<Fce9>}
    };
    #ELSE {
        #VAR tmp_color {<Fec9><388>}
    };
    #RETURN ${tmp_color}%0
}

#VAR pfort
{
    {1}{wie ein Druide - naemlich ueberhaupt nicht}
    {2}{fast ueberhaupt nicht}
    {3}{miserabel wie ein Vagabund}
    {4}{wie ein blutiger Anfaenger}
    {5}{wie ein junger Knappe}
    {6}{schlecht}
    {7}{maessig}
    {8}{mittelmaessig}
    {9}{unterdurchschnittlich wie ein Soeldner}
    {10}{durchschnittlich}
    {11}{ueberdurchschnittlich}
    {12}{gut}
    {13}{sehr gut}
    {14}{wie ein Burgwaechter}
    {15}{wie ein hochdekorierter Veteran}
    {16}{wie ein hochbegabter Meister}
    {17}{beinahe engelgleich}
    {18}{engelgleich}
    {19}{legendaer}
    {20}{beinahe goettlich}
    {21}{goettlich}
}

#NOP { /**
 *  @brief  Zeigt Stufen fuer den Skill-Fortschritt
 *
 */};

#ALIAS {pfort} {
    #VAR tmp_count {1};
    #SCREEN GET {SCROLL_COLS} {tmp_width};
    #VAR tmp_line {};
    #WHILE {$tmp_count <= &pfort[] } {
        #FORMAT {tmp_line_len} {%L} {$tmp_line};
        #FORMAT {tmp_item_len} {%L} {$pfort[$tmp_count]};
        #MATH {tmp_total_len} {$tmp_line_len + $tmp_item_len + 5};

        #VAR tmp_item @pala_fert{$pfort[$tmp_count]};

        #IF {$tmp_total_len > $tmp_width} {
            #ECHO {$tmp_line<099>};
            #VAR tmp_line {$tmp_item};
        };
        #ELSEIF {"$tmp_line" == ""} {
            #VAR tmp_line {$tmp_item};
        };
        #ELSE {
            #CAT tmp_line {     $tmp_item}
        };
        inc tmp_count
    };
    #ECHO {$tmp_line<099>}
} {5};

add_help {pfort} {paladine}
    {Zeigt eine Liste der Fertigkeitsstufen an}
    {pfort}

#NOP { /**
 *	@brief	Spezialangriff durch Schwertkampf
 */};

#ACTION {^Dusty segnet Deine Attacke!} {
    setze_angriff_effekte 2 D;
    #LINE GAG
}

#NOP { /**
 *	@brief	Spell: Schildparade
 */};

#ACTION {^Du reckst Dein Schild gen Himmel!} {
